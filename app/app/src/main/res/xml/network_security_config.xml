<?xml version="1.0" encoding="utf-8"?>
<!-- Home Assistant is often reached over plain HTTP on the LAN, or over HTTPS
     with a self-signed certificate installed as a user CA. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
